# Shivam Stack Backend — Environment Variables
# Copy this file to .env and fill in real values.
#
# Note: this file was reconstructed from actual `process.env.*` usages found
# in the codebase. A .env.example did not exist in the repository — .env is
# listed in .gitignore, and it appears the example file was either never
# committed or excluded along with it.
#
# Do not commit your actual .env file. Nothing below is a real secret.

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb://localhost:27017/shivam-stack

# ----------------------------------------------------------------------------
# Authentication (JWT)
# Used in: middleware/userAuth.js, middleware/adminAuth.js, services/tokenService.js
# ----------------------------------------------------------------------------

JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_ADMIN_ACCESS_EXPIRE=15m
JWT_ADMIN_REFRESH_EXPIRE=7d

# ----------------------------------------------------------------------------
# Cloudinary (file/image uploads)
# Used in: config/cloudinary.js, middleware/cloudinaryUploader.js
# ----------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# SendGrid (transactional email)
# Used in: services/emailService.js
# ----------------------------------------------------------------------------

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ----------------------------------------------------------------------------
# Frontend / CORS / cross-service URLs
# Used in: app.js (CORS allowlist), services/emailService.js (links in emails),
# scheduler/keepAlive.js (self-ping target)
# ----------------------------------------------------------------------------

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

PRODUCTION_BASE_FRONTEND_URL=https://shivam-webstack.netlify.app
DEVELOPMENT_BASE_FRONTEND_URL=http://localhost:5173

PRODUCTION_BASE_BACKEND_URL=https://shivam-stack-backend.onrender.com
DEVELOPMENT_BASE_BACKEND_URL=http://localhost:5000

API_URL=http://localhost:5000
APP_NAME=Shivam Stack

# ----------------------------------------------------------------------------
# Admin notifications
# ----------------------------------------------------------------------------

ADMIN_EMAIL=admin@example.com
ADMIN_URL=http://localhost:5173/admin

# ----------------------------------------------------------------------------
# Public-facing contact details (surfaced by /api/public endpoints)
# ----------------------------------------------------------------------------

CONTACT_EMAIL_GENERAL=hello@example.com
CONTACT_EMAIL_SUPPORT=support@example.com
CONTACT_EMAIL_SECURITY=security@example.com
CONTACT_EMAIL_PRIVACY=privacy@example.com
CONTACT_EMAIL_LEGAL=legal@example.com
CONTACT_EMAIL_COLLAB=collab@example.com
CONTACT_YOUTUBE=https://youtube.com/@example

# ----------------------------------------------------------------------------
# Unverified / unclear purpose
# These are referenced in the codebase but their exact intended use is not
# obvious from context alone (short, unlabeled names, no comments at the
# usage site). Verify against your own working .env before relying on this
# list — they may be leftover from shared naming conventions with the
# frontend's Vite env variables rather than values this backend truly needs.
# ----------------------------------------------------------------------------

VITE_G=
VITE_L=
VITE_M=
VITE_T=
VITE_W=
